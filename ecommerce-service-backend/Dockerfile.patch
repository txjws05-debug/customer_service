# 中台补丁镜像：以线上运行的镜像为底座，整体覆盖 app 目录。
#
# 整目录而非逐文件：逐文件清单在加模块时极易漏（本项目已经漏过一次），
# 而 app/ 本身很小，整目录覆盖更省心也更安全。
#
# 注意：本文件必须放在 ecommerce-service-backend/ 下，因为仓库根的 .dockerignore
# 把整个 ecommerce-service-backend 目录排除了，用根目录做上下文会 COPY 不到。
ARG BASE=ghcr.io/txjws05-debug/customer-service-ecommerce:b1d4aff645e411213f4ba75357778127f2421306
FROM ${BASE}

COPY app /app/app
