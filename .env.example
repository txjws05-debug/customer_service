# ============================================================
# 客服 Agent（后端）环境变量模板 —— 本地开发用
# 复制为项目根目录的 .env 后填写真实值：
#   cp .env.example .env
# .env 已在 .gitignore 中排除，禁止提交。
#
# Docker 部署不使用本文件，改用 deploy/backend.env（见 deploy/backend.env.example）
# ============================================================

# ---------- 大模型 ----------
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-with-your-own-key

# ---------- 电商中台 ----------
# 本地直跑：中台在宿主机 18081
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ---------- 数据库（PostgreSQL，已启用 pgvector）----------
DATABASE_URL=postgresql+asyncpg://cs:cs_pass_change_me@127.0.0.1:5432/customer_service

# ---------- 服务监听 ----------
APP_HOST=0.0.0.0
APP_PORT=18082

# ---------- JWT ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- RAG 向量检索（可选）----------
# 三项都不填 → 用内置本地词法向量（零依赖，但只有字面重合度，没有语义泛化）。
# 想要语义检索就填一个 OpenAI 兼容的 embedding 服务，详见 deploy/backend.env.example
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_DIM=512

# 知识库：改了语料/模型后启动会自动重建索引；也可手动执行
#   python -m ws.knowledge.reindex --force
# KNOWLEDGE_TOP_K=4
# KNOWLEDGE_MIN_SCORE=0.12
