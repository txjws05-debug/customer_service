# 统一行尾，避免 Windows 检出后把 CRLF 带进容器导致脚本执行失败
# （例如 shell 脚本 shebang 变成 "#!/bin/bash\r"）

# 默认：由 git 按内容自动判断，检出时转成平台默认
* text=auto

# Shell 脚本必须保持 LF，否则 Linux 容器内会报 bad interpreter
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# YAML / SQL / 配置：Linux 端使用，统一 LF
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.env text eol=lf
.env.example text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
