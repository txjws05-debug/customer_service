# 前端运行时镜像：产物由限内存容器内的 next build 生成（见 /tmp/fe_build.sh），这里只组装运行时。
# 运行时配置与 frontend/Dockerfile 的 runner 阶段一致。
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=Asia/Shanghai
COPY standalone/ ./
COPY static ./.next/static
COPY public ./public
EXPOSE 3000
CMD ["node", "server.js"]
