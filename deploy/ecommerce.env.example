# ============================================================
# 电商中台运行时变量 —— 由 docker-compose 以 env_file 方式注入
# 复制为 deploy/ecommerce.env 后填写真实值：
#   cp deploy/ecommerce.env.example deploy/ecommerce.env
#
# 注意：本文件含密码，已在 .gitignore 中排除，禁止提交。
# 部署脚本 deploy.sh 会自动把密码同步成 deploy/.env 里的 POSTGRES_PASSWORD。
# ============================================================

# 连接同一个 PostgreSQL 实例的 commerce 库（容器内主机名固定为 postgres）
DATABASE_URL=postgresql+psycopg2://cs:__DB_PASSWORD__@postgres:5432/commerce

# 启动时若库为空则写入课程演示数据
SEED_ON_STARTUP=true
