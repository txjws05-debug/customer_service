# ============================================================
# 后端（客服 Agent）运行时变量 —— 由 docker-compose 以 env_file 方式注入
# 复制为 deploy/backend.env 后填写真实值：
#   cp deploy/backend.env.example deploy/backend.env
#
# 注意：本文件含真实密钥，已在 .gitignore 中排除，禁止提交。
# 容器内的 COMMERCE_API_BASE_URL 与 APP_PORT 由 compose 覆盖为容器网络地址。
# ============================================================

# ---------- 大模型 ----------
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# 换成你自己的 Key；若 Key 中含 $ 符号需写成 $$
LLM_API_KEY=sk-replace-with-your-own-key

# ---------- 数据库（容器内主机名固定为 postgres）----------
DATABASE_URL=postgresql+asyncpg://cs:please_change_this_pg_password@postgres:5432/customer_service

# ---------- 电商中台 ----------
# config.py 中此项为必填（无默认值）。
# Docker 部署时会被 docker-compose 覆盖为容器网络地址 http://ecommerce:18081，
# 因此容器里这里的值不生效；但本地非 Docker 运行必须填真实地址，否则启动即 ValidationError。
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ---------- 服务监听 ----------
APP_HOST=0.0.0.0
APP_PORT=18082

# ---------- JWT ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
