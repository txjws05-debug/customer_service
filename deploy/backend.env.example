# ============================================================
# 后端（客服 Agent）运行时变量 —— 由 docker-compose 以 env_file 方式注入
# 复制为 deploy/backend.env 后填写真实值：
#   cp deploy/backend.env.example deploy/backend.env
#
# 注意：本文件含真实密钥，已在 .gitignore 中排除，禁止提交。
# 容器内的 COMMERCE_API_BASE_URL 与 APP_PORT 由 compose 覆盖为容器网络地址。
# ============================================================

# ---------- 大模型 ----------
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# 换成你自己的 Key；若 Key 中含 $ 符号需写成 $$
LLM_API_KEY=sk-replace-with-your-own-key

# ---------- 数据库（容器内主机名固定为 postgres）----------
DATABASE_URL=postgresql+asyncpg://cs:please_change_this_pg_password@postgres:5432/customer_service

# ---------- 电商中台 ----------
# config.py 中此项为必填（无默认值）。
# Docker 部署时会被 docker-compose 覆盖为容器网络地址 http://ecommerce:18081，
# 因此容器里这里的值不生效；但本地非 Docker 运行必须填真实地址，否则启动即 ValidationError。
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 登录用户 → 商城账号的兜底映射（演示用）：登录名不是 uXXXX 时按这个账号办理交易。
# 留空则不兜底，客服会提示用户先绑定商城账号。
COMMERCE_DEFAULT_USER_ID=u1001

# ---------- 服务监听 ----------
APP_HOST=0.0.0.0
APP_PORT=18082

# ---------- JWT ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- RAG 向量检索（可选）----------
# 不配置时用内置的「本地词法向量」：零依赖、离线可用，但只按字面重合度检索，
# 没有语义泛化能力（能跑通，质量一般）。
#
# 想要真正的语义检索，填一个 OpenAI 兼容的 embedding 服务即可，代码无需改动。
# 推荐阿里云百炼（服务器也在阿里云，链路最短；text-embedding-v3/v4 各有
# 100 万 Token 免费额度，开通后 90 天内有效，之后约 0.5 元/百万 Token）：
#   1) 百炼控制台开通服务 → 创建 API Key
#   2) 填下面三行（base_url 用旧域名最省事；业务空间专属域名性能更好，
#      形如 https://{业务空间ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_API_KEY=sk-你的key
# EMBEDDING_DIM 留空即可：启动时会自动探测模型输出维度（v3 默认 1024）
# EMBEDDING_DIM=
#
# 其它兼容服务同理，例如硅基流动：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_MODEL=BAAI/bge-m3
#
# 换模型 / 改维度 / 改语料后，重启容器会自动重建索引，不需要手工迁移。
# 填好 key 后建议先验证一次（不连数据库，只探测维度并做语义相似度自检）：
#   docker exec cs-backend python -m ws.knowledge.reindex --probe
#
# 【推荐】别手工改这个文件：把上面三项配成 GitHub Secrets
#   EMBEDDING_BASE_URL / EMBEDDING_MODEL / EMBEDDING_API_KEY
# （EMBEDDING_DIM 不用建，留空 = 自动探测）
# 部署时会由 deploy/apply-secrets.sh 自动写入本文件并重建 backend 容器，
# 改 key / 换模型只改 Secret 再重跑流水线即可，不需要登录服务器。

# 检索调参（通常不用改）：候选召回数 / 最终返回条数 / 低于该分视为没检索到
# KNOWLEDGE_CANDIDATES=20
# KNOWLEDGE_TOP_K=4
# KNOWLEDGE_MIN_SCORE=0.12
# 启动时自动建表建索引，失败只告警
# KNOWLEDGE_AUTO_INDEX=true
