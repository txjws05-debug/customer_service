# ============================================================
# Node A 部署变量（docker compose 读取，位于 deploy/.env）
# 复制为 deploy/.env 后按需修改：
#   cp deploy/.env.example deploy/.env
# 该文件含密码，已在 .gitignore 中排除，务必不要提交。
# ============================================================

# ---------- 镜像仓库 ----------
# GitHub Actions 会把镜像推到 ghcr.io/<owner>/...
REGISTRY=ghcr.io
# 由 deploy.sh 自动写入当前 commit SHA；不要手工长期固定为 latest
IMAGE_TAG=latest

# ---------- 访问入口 ----------
# 无域名：保持 :80，用 http://<公网IP> 访问
SITE_ADDRESS=:80
# 改为域名示例：SITE_ADDRESS=cs.example.com
# 无域名但要 HTTPS：SITE_ADDRESS=1.2.3.4.nip.io
HTTP_PORT=80
HTTPS_PORT=443

# ---------- PostgreSQL（客服 Agent 主库 + pgvector 向量库）----------
POSTGRES_USER=cs
POSTGRES_PASSWORD=please_change_this_pg_password
POSTGRES_DB=customer_service

# ---------- MySQL（电商中台业务库）----------
MYSQL_ROOT_PASSWORD=please_change_this_mysql_root
MYSQL_DATABASE=atguigu_commerce
MYSQL_USER=app
MYSQL_PASSWORD=please_change_this_mysql_app
